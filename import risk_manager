def load_policy():

    if not os.path.exists(
        POLICY_FILE
    ):

        return DEFAULT_POLICY.copy()


    try:

        with open(
            POLICY_FILE,
            "r",
            encoding="utf-8"
        ) as f:

            policy = json.load(f)


        if not isinstance(
            policy,
            dict
        ):

            return DEFAULT_POLICY.copy()


        result = DEFAULT_POLICY.copy()

        result.update(
            policy
        )

        return result


    except Exception as e:

        print(
            f"⚠ policy読み込み失敗: {e}"
        )

        return DEFAULT_POLICY.copy()


# =========================================================
# リスク状態
# =========================================================

def default_risk_state():

    current = now_jst()

    today = current.strftime(
        "%Y-%m-%d"
    )

    month = current.strftime(
        "%Y-%m"
    )

    return {

        "date":
            today,

        "month":
            month,

        "capital":
            INITIAL_CAPITAL,

        "peak_capital":
            INITIAL_CAPITAL,

        "day_start_capital":
            INITIAL_CAPITAL,

        "month_start_capital":
            INITIAL_CAPITAL,

        "daily_pnl":
            0.0,

        "realized_pnl":
            0.0,

        "open_positions":
            0,

        "positions":
            {},

        "consecutive_losses":
            0,

        "risk_locked":
            False,

        "trading_enabled":
            True,

        "stop_reason":
            "",

        "last_update":
            current.isoformat(),

    }


def load_risk_state():

    if not os.path.exists(
        RISK_STATE_FILE
    ):

        state = default_risk_state()

        save_risk_state(
            state
        )

        return state


    try:

        with open(
            RISK_STATE_FILE,
            "r",
            encoding="utf-8"
        ) as f:

            state = json.load(f)


        if not isinstance(
            state,
            dict
        ):

            raise ValueError(
                "risk stateがdictではありません"
            )


        defaults = default_risk_state()

        defaults.update(
            state
        )


        if (
            "positions"
            not in defaults
            or
            not isinstance(
                defaults["positions"],
                dict
            )
        ):

            defaults["positions"] = {}


        defaults["open_positions"] = (
            len(
                defaults["positions"]
            )
        )


        return defaults


    except Exception as e:

        print(
            f"⚠ risk state読み込み失敗: {e}"
        )

        return default_risk_state()


def save_risk_state(
    state
):

    state["last_update"] = (
        now_jst().isoformat()
    )


    with open(
        RISK_STATE_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            state,
            f,
            ensure_ascii=False,
            indent=2
        )


# =========================================================
# 日次リセット
# =========================================================

def reset_daily_state_if_needed(
    state
):

    today = now_jst().strftime(
        "%Y-%m-%d"
    )


    if (
        state.get("date")
        !=
        today
    ):

        state["date"] = today

        state["day_start_capital"] = (
            float(
                state.get(
                    "capital",
                    INITIAL_CAPITAL
                )
            )
        )

        state["daily_pnl"] = 0.0

        state["consecutive_losses"] = 0

        state["trading_enabled"] = True

        state["stop_reason"] = ""


    return state


# =========================================================
# 月次リセット
# =========================================================

def reset_monthly_state_if_needed(
    state
):

    month = now_jst().strftime(
        "%Y-%m"
    )


    if (
        state.get("month")
        !=
        month
    ):

        state["month"] = month

        state["month_start_capital"] = (
            float(
                state.get(
                    "capital",
                    INITIAL_CAPITAL
                )
            )
        )

        state["risk_locked"] = False


    return state


# =========================================================
# state同期
# =========================================================

def _sync_state(
    state
):

    state = reset_daily_state_if_needed(
        state
    )

    state = reset_monthly_state_if_needed(
        state
    )

    state["open_positions"] = (
        len(
            state.get(
                "positions",
                {}
            )
        )
    )

    return state


# =========================================================
# 利用可能資金
# =========================================================

def get_available_cash(
    state=None
):

    if state is None:

        state = load_risk_state()


    capital = float(
        state.get(
            "capital",
            INITIAL_CAPITAL
        )
    )


    positions = state.get(
        "positions",
        {}
    )


    invested = sum(
        float(
            position.get(
                "value",
                0.0
            )
        )
        for position
        in positions.values()
    )


    return max(
        0.0,
        capital - invested
    )


# =========================================================
# 現在の1トレードリスク
# =========================================================

def current_risk_per_trade(
    state=None
):

    if state is None:

        state = load_risk_state()


    if state.get(
        "risk_locked",
        False
    ):

        return (
            RISK_PER_TRADE
            *
            LOCKED_RISK_MULTIPLIER
        )


    return RISK_PER_TRADE


# =========================================================
# 最大損失額
# =========================================================

def max_loss_amount(
    capital,
    state=None
):

    return (
        float(capital)
        *
        current_risk_per_trade(
            state
        )
    )


# =========================================================
# 現在DD
# =========================================================

def current_drawdown(
    capital=None
):

    state = load_risk_state()

    state = _sync_state(
        state
    )


    if capital is None:

        capital = float(
            state.get(
                "capital",
                INITIAL_CAPITAL
            )
        )


    peak = float(
        state.get(
            "peak_capital",
            capital
        )
    )


    if peak <= 0:

        return 0.0


    return (
        capital
        /
        peak
        - 1.0
    )


# =========================================================
# ATRベース株数計算
#
# 1回の最大損失を資金の0.5%以内にする。
#
# さらに既存ポジションを差し引いた
# 利用可能資金の範囲内に制限。
# =========================================================

def calculate_position_size(
    capital,
    entry_price,
    stop_loss,
    open_value=0.0,
    state=None
):

    capital = float(
        capital
    )

    entry_price = float(
        entry_price
    )

    stop_loss = float(
        stop_loss
    )

    open_value = float(
        open_value
    )


    if (
        capital <= 0
        or
        entry_price <= 0
    ):

        return 0


    per_share_risk = (
        entry_price
        -
        stop_loss
    )


    if per_share_risk <= 0:

        return 0


    risk_budget = (
        max_loss_amount(
            capital,
            state
        )
    )


    shares_by_risk = int(
        risk_budget
        /
        per_share_risk
    )


    if shares_by_risk < 1:

        return 0


    available_cash = max(
        0.0,
        capital - open_value
    )


    # 手数料 + スリッページの余裕込み
    entry_cost_per_share = (
        entry_price
        *
        (
            1
            +
            TRADING_FEE_RATE
            +
            SLIPPAGE_RATE
        )
    )


    if entry_cost_per_share <= 0:

        return 0


    shares_by_cash = int(
        available_cash
        /
        entry_cost_per_share
    )


    shares = min(
        shares_by_risk,
        shares_by_cash
    )


    return max(
        0,
        shares
    )


# =========================================================
# 自動株数計算
# =========================================================

def calculate_position_size_auto(
    entry_price,
    stop_loss
):

    state = load_risk_state()

    state = _sync_state(
        state
    )


    capital = float(
        state.get(
            "capital",
            INITIAL_CAPITAL
        )
    )


    open_value = sum(
        float(
            position.get(
                "value",
                0.0
            )
        )
        for position
        in state.get(
            "positions",
            {}
        ).values()
    )


    return calculate_position_size(
        capital=capital,
        entry_price=entry_price,
        stop_loss=stop_loss,
        open_value=open_value,
        state=state
    )


# =========================================================
# ポジションプラン
# =========================================================

def build_position_plan(
    capital,
    ticker,
    entry_price,
    take_profit,
    stop_loss
):

    state = load_risk_state()

    state = _sync_state(
        state
    )


    open_value = sum(
        float(
            position.get(
                "value",
                0.0
            )
        )
        for position
        in state.get(
            "positions",
            {}
        ).values()
    )


    shares = calculate_position_size(
        capital=capital,
        entry_price=entry_price,
        stop_loss=stop_loss,
        open_value=open_value,
        state=state
    )


    if shares <= 0:

        return {

            "ticker":
                ticker,

            "shares":
                0,

            "entry_price":
                entry_price,

            "take_profit":
                take_profit,

            "stop_loss":
                stop_loss,

            "position_value":
                0.0,

            "max_loss":
                0.0,

        }


    position_value = (
        shares
        *
        entry_price
    )


    max_loss = (
        shares
        *
        (
            entry_price
            -
            stop_loss
        )
    )


    return {

        "ticker":
            ticker,

        "shares":
            shares,

        "entry_price":
            entry_price,

        "take_profit":
            take_profit,

        "stop_loss":
            stop_loss,

        "position_value":
            position_value,

        "max_loss":
            max_loss,

    }


# =========================================================
# ポジション新規登録
#
# ★資金チェックを追加
#
# 既存ポジション + 新規ポジション
# が利用可能資金を超える場合は登録拒否。
# =========================================================

def register_position_open(
    ticker,
    shares,
    entry_price
):

    state = load_risk_state()

    state = _sync_state(
        state
    )


    if not state.get(
        "trading_enabled",
        True
    ):

        print(
            "🛑 取引停止中のため新規ポジション登録不可"
        )

        return state


    positions = state.setdefault(
        "positions",
        {}
    )


    if (
        ticker in positions
    ):

        print(
            f"⚠ 既に保有中: {ticker}"
        )

        return state


    if len(positions) >= MAX_POSITIONS:

        print(
            f"🛑 同時保有上限 "
            f"{MAX_POSITIONS}銘柄"
        )

        state[
            "trading_enabled"
        ] = False

        state[
            "stop_reason"
        ] = "同時保有数上限"


        save_risk_state(
            state
        )

        return state


    shares = int(
        shares
    )

    entry_price = float(
        entry_price
    )


    if (
        shares <= 0
        or
        entry_price <= 0
    ):

        print(
            "⚠ 不正なポジション"
        )

        return state


    current_capital = float(
        state.get(
            "capital",
            INITIAL_CAPITAL
        )
    )


    invested = sum(
        float(
            position.get(
                "value",
                0.0
            )
        )
        for position
        in positions.values()
    )


    gross_entry_value = (
        shares
        *
        entry_price
    )


    estimated_entry_cost = (
        gross_entry_value
        *
        (
            1
            +
            TRADING_FEE_RATE
            +
            SLIPPAGE_RATE
        )
    )


    available_cash = max(
        0.0,
        current_capital - invested
    )


    # =====================================================
    # 新規追加:
    # 利用可能資金を超える場合は登録拒否
    # =====================================================

    if (
        estimated_entry_cost
        >
        available_cash
    ):

        print(
            f"🛑 資金不足: "
            f"{ticker}"
        )

        print(
            f"必要額="
            f"{estimated_entry_cost:,.0f}円"
        )

        print(
            f"利用可能="
            f"{available_cash:,.0f}円"
        )

        return state


    value = (
        gross_entry_value
    )


    positions[ticker] = {

        "shares":
            shares,

        "entry_price":
            entry_price,

        "value":
            value,

        "entry_fee":
            gross_entry_value
            *
            TRADING_FEE_RATE,

        "entry_slippage":
            gross_entry_value
            *
            SLIPPAGE_RATE,

        "entry_date":
            now_jst().strftime(
                "%Y-%m-%d"
            ),

    }


    state["open_positions"] = (
        len(
            positions
        )
    )


    save_risk_state(
        state
    )


    print(
        f"✅ ポジション登録: "
        f"{ticker} "
        f"{shares}株 "
        f"{entry_price:,.0f}円"
    )


    return state


# =========================================================
# ポジション決済
#
# ★手数料 + スリッページ
# ★連敗
# ★月間利益ロック
# ★DD
# ★デイリーストップ
# =========================================================

def register_position_close(
    ticker,
    exit_price,
    new_capital=None
):

    state = load_risk_state()

    state = _sync_state(
        state
    )


    positions = state.get(
        "positions",
        {}
    )


    position = positions.pop(
        ticker,
        None
    )


    state["open_positions"] = (
        len(
            positions
        )
    )


    if position is None:

        print(
            f"⚠ ポジションが見つかりません: "
            f"{ticker}"
        )

        save_risk_state(
            state
        )

        return state


    shares = int(
        position[
            "shares"
        ]
    )


    entry_price = float(
        position[
            "entry_price"
        ]
    )


    exit_price = float(
        exit_price
    )


    entry_value = (
        shares
        *
        entry_price
    )


    exit_value = (
        shares
        *
        exit_price
    )


    # =====================================================
    # スリッページ
    #
    # 買い:
    # 実質高く買う
    #
    # 売り:
    # 実質安く売る
    # =====================================================

    effective_entry_price = (
        entry_price
        *
        (
            1
            +
            SLIPPAGE_RATE
        )
    )


    effective_exit_price = (
        exit_price
        *
        (
            1
            -
            SLIPPAGE_RATE
        )
    )


    effective_entry_value = (
        shares
        *
        effective_entry_price
    )


    effective_exit_value = (
        shares
        *
        effective_exit_price
    )


    gross_pnl = (
        effective_exit_value
        -
        effective_entry_value
    )


    fees = (
        effective_entry_value
        +
        effective_exit_value
    ) * TRADING_FEE_RATE


    pnl = (
        gross_pnl
        -
        fees
    )


    old_capital = float(
        state.get(
            "capital",
            INITIAL_CAPITAL
        )
    )


    if new_capital is None:

        new_capital = (
            old_capital
            +
            pnl
        )


    new_capital = float(
        new_capital
    )


    state["daily_pnl"] += pnl

    state["realized_pnl"] += pnl

    state["capital"] = new_capital


    # =====================================================
    # Peak更新
    # =====================================================

    peak = float(
        state.get(
            "peak_capital",
            new_capital
        )
    )


    if new_capital > peak:

        peak = new_capital


    state["peak_capital"] = peak


    # =====================================================
    # 連敗
    # =====================================================

    if pnl < 0:

        state[
            "consecutive_losses"
        ] = (
            int(
                state.get(
                    "consecutive_losses",
                    0
                )
            )
            +
            1
        )

    else:

        state[
            "consecutive_losses"
        ] = 0


    # =====================================================
    # 月間利益
    # =====================================================

    month_start = float(
        state.get(
            "month_start_capital",
            INITIAL_CAPITAL
        )
    )


    month_return = (
        new_capital
        /
        month_start
        -
        1
    ) if month_start > 0 else 0.0


    if (
        LOCK_RISK_AFTER_TARGET
        and
        month_return
        >=
        MONTHLY_TARGET
    ):

        state[
            "risk_locked"
        ] = True


    # =====================================================
    # 停止判定
    # =====================================================

    _apply_stop_checks(
        state,
        new_capital,
        peak
    )


    save_risk_state(
        state
    )


    print(
        f"✅ 決済: {ticker} "
        f"PnL={pnl:+,.0f}円 "
        f"資金={new_capital:,.0f}円"
    )


    return state


# =========================================================
# 停止判定
# =========================================================

def _apply_stop_checks(
    state,
    capital,
    peak
):

    reasons = []


    # =====================================================
    # DD
    # =====================================================

    drawdown = (
        capital
        /
        peak
        -
        1
    ) if peak > 0 else 0.0


    if (
        drawdown
        <=
        -MAX_DRAWDOWN
    ):

        reasons.append(
            f"最大DD "
            f"{drawdown * 100:.2f}%"
        )


    # =====================================================
    # 日次損失
    # =====================================================

    day_start = float(
        state.get(
            "day_start_capital",
            capital
        )
    )


    daily_pnl = float(
        state.get(
            "daily_pnl",
            0.0
        )
    )


    daily_return = (
        daily_pnl
        /
        day_start
    ) if day_start > 0 else 0.0


    if (
        daily_return
        <=
        -DAILY_STOP_LOSS
    ):

        reasons.append(
            f"デイリーストップ "
            f"{daily_return * 100:.2f}%"
        )


    # =====================================================
    # 連敗
    # =====================================================

    consecutive_losses = int(
        state.get(
            "consecutive_losses",
            0
        )
    )


    if (
        consecutive_losses
        >=
        MAX_CONSECUTIVE_LOSSES
    ):

        reasons.append(
            f"{MAX_CONSECUTIVE_LOSSES}連敗"
        )


    # =====================================================
    # 結果
    # =====================================================

    if reasons:

        state[
            "trading_enabled"
        ] = False

        state[
            "stop_reason"
        ] = " / ".join(
            reasons
        )

    else:

        # 月次ロックは停止ではない
        state[
            "trading_enabled"
        ] = True

        state[
            "stop_reason"
        ] = ""


