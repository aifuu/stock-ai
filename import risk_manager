# =========================================================
# 総合リスクチェック
# =========================================================

def risk_check():

    state = load_risk_state()

    state = _sync_state(
        state
    )


    capital = float(
        state.get(
            "capital",
            INITIAL_CAPITAL
        )
    )


    peak = float(
        state.get(
            "peak_capital",
            capital
        )
    )


    drawdown = (
        capital
        /
        peak
        -
        1
    ) if peak > 0 else 0.0


    performance = (
        check_live_performance()
    )


    reasons = []


    enabled = True


    # =====================================================
    # DD
    # =====================================================

    if (
        drawdown
        <=
        -MAX_DRAWDOWN
    ):

        enabled = False

        reasons.append(
            f"最大DD "
            f"{drawdown * 100:.2f}%"
        )


    # =====================================================
    # 日次損失
    # =====================================================

    day_start = float(
        state.get(
            "day_start_capital",
            capital
        )
    )


    daily_pnl = float(
        state.get(
            "daily_pnl",
            capital - day_start
        )
    )


    daily_return = (
        daily_pnl
        /
        day_start
        if
        day_start > 0
        else
        0.0
    )


    if (
        daily_return
        <=
        -DAILY_STOP_LOSS
    ):

        enabled = False

        reasons.append(
            f"日次損失 "
            f"{daily_return * 100:.2f}%"
        )


    # =====================================================
    # 連敗
    # =====================================================

    consecutive_losses = int(
        state.get(
            "consecutive_losses",
            0
        )
    )


    if (
        consecutive_losses
        >=
        MAX_CONSECUTIVE_LOSSES
    ):

        enabled = False

        reasons.append(
            f"{MAX_CONSECUTIVE_LOSSES}連敗"
        )


    # =====================================================
    # PF
    # =====================================================

    if performance["stop"]:

        enabled = False

        reasons.append(
            performance["reason"]
        )


    # =====================================================
    # 同時保有
    # =====================================================

    open_positions = len(
        state.get(
            "positions",
            {}
        )
    )


    state[
        "open_positions"
    ] = open_positions


    if (
        open_positions
        >=
        MAX_POSITIONS
    ):

        enabled = False

        reasons.append(
            "同時保有数上限"
        )


    # =====================================================
    # 状態保存
    # =====================================================

    state[
        "trading_enabled"
    ] = enabled


    state[
        "stop_reason"
    ] = (
        " / ".join(
            reasons
        )
        if
        reasons
        else
        ""
    )


    save_risk_state(
        state
    )


    # =====================================================
    # 月次
    # =====================================================

    month_start = float(
        state.get(
            "month_start_capital",
            INITIAL_CAPITAL
        )
    )


    month_return = (
        capital
        /
        month_start
        -
        1
    ) if month_start > 0 else 0.0


    return {

        "trading_enabled":
            enabled,

        "capital":
            capital,

        "available_cash":
            get_available_cash(
                state
            ),

        "drawdown":
            drawdown,

        "daily_return":
            daily_return,

        "month_return":
            month_return,

        "risk_locked":
            state.get(
                "risk_locked",
                False
            ),

        "consecutive_losses":
            consecutive_losses,

        "open_positions":
            open_positions,

        "performance":
            performance,

        "reason":
            state[
                "stop_reason"
            ],

        "current_risk":
            current_risk_per_trade(
                state
            ),

    }


