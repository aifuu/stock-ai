# =========================================================
# 旧API: record_trade_pnl
# =========================================================

def record_trade_pnl(
    pnl,
    new_capital
):

    state = load_risk_state()

    state = _sync_state(
        state
    )


    pnl = float(
        pnl
    )

    new_capital = float(
        new_capital
    )


    state["daily_pnl"] += pnl

    state["realized_pnl"] += pnl

    state["capital"] = new_capital


    peak = float(
        state.get(
            "peak_capital",
            new_capital
        )
    )


    if new_capital > peak:

        peak = new_capital


    state["peak_capital"] = peak


    if pnl < 0:

        state[
            "consecutive_losses"
        ] += 1

    else:

        state[
            "consecutive_losses"
        ] = 0


    month_start = float(
        state.get(
            "month_start_capital",
            INITIAL_CAPITAL
        )
    )


    month_return = (
        new_capital
        /
        month_start
        -
        1
    ) if month_start > 0 else 0.0


    if (
        LOCK_RISK_AFTER_TARGET
        and
        month_return
        >=
        MONTHLY_TARGET
    ):

        state[
            "risk_locked"
        ] = True


    _apply_stop_checks(
        state,
        new_capital,
        peak
    )


    save_risk_state(
        state
    )


    return state


