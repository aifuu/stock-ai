        )

        return pd.DataFrame()


# =========================================================
# PF
# =========================================================

def calculate_profit_factor(
    returns
):

    returns = (
        pd.Series(
            returns
        )
        .dropna()
    )


    gains = returns[
        returns > 0
    ].sum()


    losses = (
        -returns[
            returns < 0
        ].sum()
    )


    if losses <= 0:

        if gains > 0:

            return float(
                "inf"
            )

        return 0.0


    return float(
        gains
        /
        losses
    )


# =========================================================
# 成績集計内部関数
# =========================================================

def _calculate_performance(
    df
):

    empty = {

        "trades":
            0,

        "wins":
            0,

        "losses":
            0,

        "win_rate":
            0.0,

        "avg_return":
            0.0,

        "profit_factor":
            0.0,

    }


    if (
        df is None
        or
        df.empty
        or
        "result" not in df.columns
    ):

        return empty


    decided = df[
        df["result"].isin(
            [
                "WIN",
                "LOSS",
                "TIMEOUT_LOSS"
            ]
        )
    ].copy()


    wins = int(
        (
            decided["result"]
            ==
            "WIN"
        ).sum()
    )


    losses = int(
        (
            decided["result"]
            .isin(
                [
                    "LOSS",
                    "TIMEOUT_LOSS"
                ]
            )
        ).sum()
    )


    trades = (
        wins
        +
        losses
    )


    win_rate = (
        wins
        /
        trades
        *
        100
        if
        trades > 0
        else
        0.0
    )


    returns = (
        pd.to_numeric(
            decided["return"],
            errors="coerce"
        )
        .dropna()
    )


    avg_return = (
        float(
            returns.mean()
        )
        if
        len(returns) > 0
        else
        0.0
    )


    pf = calculate_profit_factor(
        returns
    )


    return {

        "trades":
            trades,

        "wins":
            wins,

        "losses":
            losses,

        "win_rate":
            win_rate,

        "avg_return":
            avg_return,

        "profit_factor":
            pf,

    }


# =========================================================
# 実績評価
# =========================================================

def evaluate_live_performance():

    df = load_history()

    return _calculate_performance(
        df
    )


# =========================================================
# 直近PF
#
# ★追加
#
# 全期間ではなく直近N件を監視。
# =========================================================

def evaluate_recent_performance(
    window
):

    df = load_history()


    if (
        df.empty
        or
        "date" not in df.columns
    ):

        return _calculate_performance(
            pd.DataFrame()
        )


    df = df.sort_values(
        "date"
    )


    decided = df[
        df["result"].isin(
            [
                "WIN",
                "LOSS",
                "TIMEOUT_LOSS"
            ]
        )
    ].copy()


    if decided.empty:

        return _calculate_performance(
            pd.DataFrame()
        )


    recent = decided.tail(
        int(window)
    ).copy()


    return _calculate_performance(
        recent
    )


# =========================================================
# ライブ成績監視
# =========================================================

def check_live_performance():

    full = evaluate_live_performance()


    reasons = []

    alert = False

    stop = False


    # =====================================================
    # 全期間PF
    # =====================================================

    if (
        full["trades"]
        >=
        MIN_LIVE_TRADES_FOR_ALERT
    ):

        full_pf = full[
            "profit_factor"
        ]


        if (
            np.isfinite(full_pf)
            and
            full_pf
            <
            MIN_LIVE_PROFIT_FACTOR
        ):

            alert = True

            stop = True

            reasons.append(
                "全期間PF "
                f"{full_pf:.2f}"
                f" < "
                f"{MIN_LIVE_PROFIT_FACTOR:.2f}"
            )


    # =====================================================
    # 直近PF
    # =====================================================

    recent_results = {}


    for window in (
        RECENT_TRADE_WINDOWS
    ):

        recent = (
            evaluate_recent_performance(
                window
            )
        )


        recent_results[
            window
        ] = recent


        if (
            recent["trades"]
            >=
            MIN_RECENT_TRADES_FOR_ALERT
        ):

            recent_pf = (
                recent[
                    "profit_factor"
                ]
            )


            if (
                np.isfinite(
                    recent_pf
                )
                and
                recent_pf
                <
                MIN_RECENT_PROFIT_FACTOR
            ):

                alert = True

                stop = True

                reasons.append(
                    f"直近{window}件PF "
                    f"{recent_pf:.2f}"
                    f" < "
                    f"{MIN_RECENT_PROFIT_FACTOR:.2f}"
                )


    return {

        "alert":
            alert,

        "stop":
            stop,

        "reason":
            " / ".join(
                reasons
            ),

        "full":
            full,

        "recent":
            recent_results,

        # 旧API互換
        "trades":
            full[
                "trades"
            ],

        "wins":
            full[
                "wins"
            ],

        "losses":
            full[
                "losses"
            ],

        "win_rate":
            full[
                "win_rate"
            ],

        "avg_return":
            full[
                "avg_return"
            ],

        "profit_factor":
            full[
                "profit_factor"
            ],

    }


# =========================================================
# 月次評価
# =========================================================

def monthly_performance():

    df = load_history()


    if (
        df.empty
        or
        "date" not in df.columns
        or
        "result" not in df.columns
    ):

        return pd.DataFrame()


    df = df.dropna(
        subset=["date"]
    ).copy()


    if df.empty:

        return pd.DataFrame()


    df["month"] = (
        df["date"]
        .dt
        .to_period("M")
        .astype(str)
    )


    rows = []


    for month, group in (
        df.groupby(
            "month"
        )
    ):

        stats = _calculate_performance(
            group
        )


        rows.append(
            {

                "month":
                    month,

                "trades":
                    stats[
                        "trades"
                    ],

                "wins":
                    stats[
                        "wins"
                    ],

                "losses":
                    stats[
                        "losses"
                    ],

                "win_rate":
                    stats[
                        "win_rate"
                    ],

                "avg_return":
                    stats[
                        "avg_return"
                    ],

                "profit_factor":
                    stats[
                        "profit_factor"
                    ],

            }
        )


    return pd.DataFrame(
        rows
    )


